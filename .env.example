SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

POSTGRES_DB=task_manager
POSTGRES_USER=task_manager
POSTGRES_PASSWORD=task_manager
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://postgres:5432/task_manager
DATABASE_USERNAME=task_manager
DATABASE_PASSWORD=task_manager

# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_BASE64_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION=PT2H
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_NAME=Admin User
BOOTSTRAP_ADMIN_EMAIL=admin@taskmanager.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@123
BOOTSTRAP_MEMBER_NAME=Member User
BOOTSTRAP_MEMBER_EMAIL=member@taskmanager.local
BOOTSTRAP_MEMBER_PASSWORD=Member@123
